{
  "name": "noeta-registry",
  "version": "0.1.0",
  "private": true,
  "description": "The Noeta package registry — an index (name+version → git coordinates) on Cloudflare Workers + D1.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:overflow": "node ../noeta-theme/scripts/check-overflow.mjs --base-url http://127.0.0.1:8787 --paths /,/para/p2p,/para/p2p/0.1.3/versions,/para/p2p/0.1.3/security,/para/p2p/0.1.3/deps",
    "migrate:local": "wrangler d1 migrations apply noeta-registry --local",
    "migrate:remote": "wrangler d1 migrations apply noeta-registry --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^4.20251011.0",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "~4.112.0"
  },
  "dependencies": {
    "@noeta/theme": "file:../noeta-theme",
    "markdown-it": "^14.3.0"
  }
}
