{
  // Noeta registry Worker. Deploy with your own Cloudflare account:
  //   wrangler d1 create noeta-registry   (paste the printed id into database_id below)
  //   npm run migrate:remote
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noeta-registry",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "observability": { "enabled": true },
  // The host noeta-pm defaults to for unmapped scopes (see manifest.rs). Wrangler
  // manages the DNS record itself — do not add a CNAME by hand.
  "routes": [{ "pattern": "registry.noeta.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noeta-registry",
      "database_id": "423b31bf-f738-422d-8a6e-a68277ff90a8",
      "migrations_dir": "migrations"
    }
  ],
  // Nightly automated D1 snapshots (src/backup.ts): data-only per-table SQL dumps under
  // `nightly/<UTC stamp>/`, manifest.json written last, newest 90 snapshots kept. The bucket is
  // created once by the operator:  wrangler r2 bucket create noeta-registry-backups
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "noeta-registry-backups"
    }
  ],
  // Self-service scope claiming (namespace-protection #1). Issuer/JWKS default to GitHub Actions'
  // public OIDC provider, so only OIDC_AUDIENCE need be set — the value the publishing workflow must
  // request its token for. Leaving OIDC_AUDIENCE unset disables OIDC claiming (the domain and GitHub
  // device-flow paths, and the admin bootstrap, still work).
  //
  // Set this to YOUR deployment's hostname, never a generic product name. GitHub mints a token for
  // whatever audience a workflow asks for, so `aud` is the only thing binding a token to one
  // recipient. If two registries share an audience, an operator of one can relay a publisher's token
  // to the other and claim that publisher's scope there — `repository_owner` still checks out, because
  // it is genuinely their token. A per-deployment audience is what breaks the relay.
  "vars": {
    "OIDC_ISSUER": "https://token.actions.githubusercontent.com",
    "OIDC_JWKS_URL": "https://token.actions.githubusercontent.com/.well-known/jwks",
    "OIDC_AUDIENCE": "registry.noeta.dev",
    // The transparency log's Ed25519 public key, raw 32 bytes as hex — committed on
    // purpose: clients pin this to verify checkpoint signatures they fetch over an
    // untrusted path. NOT the SPKI DER openssl emits by default; the client's
    // hex_to_array::<32> (noeta-pm transparency.rs) rejects anything but the raw key.
    // The private half signs checkpoints and is a Worker secret, never committed.
    "LOG_PUBLIC_KEY": "e3c79f369bc9836b948444e80fef6ea5a073f6abe78a8f7b99ff249201548c8e",
    // The advisory feed's Ed25519 public key, raw 32 bytes as hex — clients pin it to verify each
    // signed advisory and the feed head (noeta-pm advisory.rs, same "not 32 hex bytes" check as the
    // log). A DISTINCT key from LOG_PUBLIC_KEY on purpose: separate signing roles must not share a key.
    // The private half is a Worker secret (ADVISORY_PRIVATE_KEY), never committed.
    "ADVISORY_PUBLIC_KEY": "0395d6015b911e59d205799551ba0e448eefbda7564c69c91fdde37d53600cb3"
    // Advisory-intake arc: the scheduled cron (below) pulls per-source upstream adapters and imports
    // mapped packages (residual c). Each source is env-gated:
    //   • OSV (api.osv.dev): on by default; set OSV_API="off" to disable, OSV_API_URL to override.
    //   • GHSA (GitHub GraphQL): set GITHUB_TOKEN (a secret) to enable; GITHUB_GRAPHQL_URL to override.
    //   • RUSTSEC: set RUSTSEC_IMPORT_URL to its published OSV feed to enable.
    //   • OSV_IMPORT_URL: a single pre-assembled OSV feed — the manual/testing override, still supported.
    // REPORT_RATE_LIMIT overrides the per-IP report cap (tier 4, default 5/hour). Plain vars go here;
    // tokens (GITHUB_TOKEN) are secrets — `wrangler secret put GITHUB_TOKEN`.
  },
  // Two independent daily crons — src/index.ts `scheduled()` branches on which one fired:
  //   • "0 6 * * *"  — advisory import (advisory-intake arc, tier 3): pull the configured source
  //     adapters and import mapped advisories through the operator-curated name map. Idempotent per
  //     upstream id; a no-op when no source is configured.
  //   • "30 6 * * *" — nightly D1 backup to the BACKUPS R2 bucket (src/backup.ts; must equal its
  //     BACKUP_CRON constant).
  "triggers": {
    "crons": ["0 6 * * *", "30 6 * * *"]
  }
  // ADMIN_TOKEN is a secret, not committed: `wrangler secret put ADMIN_TOKEN`.
  // Transparency-log signing (namespace-protection #1): LOG_PRIVATE_KEY is a secret
  // (`wrangler secret put LOG_PRIVATE_KEY` — base64 PKCS8 Ed25519); set LOG_PUBLIC_KEY (hex) in `vars`
  // above to the matching public key so clients can pin it. Without them the log still appends and
  // serves proofs, but checkpoints return 501.
}
