{
  // Noeta registry Worker. Deploy with your own Cloudflare account:
  //   npm run migrate:remote   (after `wrangler d1 create noeta-registry` and pasting its id below)
  //   npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noeta-registry",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noeta-registry",
      // Replace with the id printed by `wrangler d1 create noeta-registry`.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Self-service scope claiming (namespace-protection #1). Issuer/JWKS default to GitHub Actions'
  // public OIDC provider, so only OIDC_AUDIENCE need be set — the value the publishing workflow must
  // request its token for (e.g. this registry's hostname). Leaving OIDC_AUDIENCE unset disables
  // claiming (the admin bootstrap still works).
  "vars": {
    "OIDC_ISSUER": "https://token.actions.githubusercontent.com",
    "OIDC_JWKS_URL": "https://token.actions.githubusercontent.com/.well-known/jwks",
    "OIDC_AUDIENCE": "noeta-registry"
    // Advisory-intake arc: the scheduled cron (below) pulls per-source upstream adapters and imports
    // mapped packages (residual c). Each source is env-gated:
    //   • OSV (api.osv.dev): on by default; set OSV_API="off" to disable, OSV_API_URL to override.
    //   • GHSA (GitHub GraphQL): set GITHUB_TOKEN (a secret) to enable; GITHUB_GRAPHQL_URL to override.
    //   • RUSTSEC: set RUSTSEC_IMPORT_URL to its published OSV feed to enable.
    //   • OSV_IMPORT_URL: a single pre-assembled OSV feed — the manual/testing override, still supported.
    // REPORT_RATE_LIMIT overrides the per-IP report cap (tier 4, default 5/hour). Plain vars go here;
    // tokens (GITHUB_TOKEN) are secrets — `wrangler secret put GITHUB_TOKEN`.
  },
  // Scheduled advisory import (advisory-intake arc, tier 3): pull the configured source adapters daily
  // and import mapped advisories through the operator-curated name map. Idempotent per upstream id; a
  // no-op when no source is configured.
  "triggers": {
    "crons": ["0 6 * * *"]
  }
  // ADMIN_TOKEN is a secret, not committed: `wrangler secret put ADMIN_TOKEN`.
  // Transparency-log signing (namespace-protection #1): LOG_PRIVATE_KEY is a secret
  // (`wrangler secret put LOG_PRIVATE_KEY` — base64 PKCS8 Ed25519); set LOG_PUBLIC_KEY (hex) in `vars`
  // above to the matching public key so clients can pin it. Without them the log still appends and
  // serves proofs, but checkpoints return 501.
}
